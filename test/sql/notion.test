# name: test/sql/notion.test
# description: SQL tests for the notion worker against the offline Notion replay server (test/mock_api/server.py)
# group: [notion]

require vgi

require-env NOTION_WORKER

require-env NOTION_FIXTURE_URL

# httpfs + json read the replay server's /__requests log to assert what was pushed down.
statement ok
LOAD httpfs;

statement ok
LOAD json;

# No ICU in the test runner: TIMESTAMPTZ values print in UTC.
statement ok
ATTACH 'notion' (TYPE vgi, LOCATION '{NOTION_WORKER}');

# ------------------------------------------------------------- secrets and errors

statement error
SELECT count(*) FROM notion.main.users;
----
<REGEX>:.*no notion secret.*

statement ok
CREATE SECRET bad_token (TYPE notion, TOKEN 'ntn_wrong', BASE_URL '{NOTION_FIXTURE_URL}', REQUESTS_PER_SECOND '50');

statement error
SELECT count(*) FROM notion.main.search();
----
<REGEX>:.*HTTP 401 unauthorized.*

statement ok
DROP SECRET bad_token;

statement ok
CREATE SECRET insecure (TYPE notion, TOKEN 'ntn_test_token', BASE_URL 'http://api.notion.com');

statement error
SELECT count(*) FROM notion.main.users;
----
<REGEX>:.*must use https.*

statement ok
DROP SECRET insecure;

statement ok
CREATE SECRET no_token (TYPE notion, BASE_URL '{NOTION_FIXTURE_URL}');

statement error
SELECT count(*) FROM notion.main.users;
----
<REGEX>:.*set TOKEN.*

statement ok
DROP SECRET no_token;

# The Notion-Version header is pinned; another version is the server's validation error.
statement ok
CREATE SECRET old_version (TYPE notion, TOKEN 'ntn_test_token', BASE_URL '{NOTION_FIXTURE_URL}', NOTION_VERSION '2022-06-28');

statement error
SELECT count(*) FROM notion.main.data_source_schema('1a2b3c4d-0000-4000-8000-00000000d501');
----
<REGEX>:.*HTTP 400 validation_error.*2022-06-28.*

statement ok
DROP SECRET old_version;

# An OAuth access token works the same way (sent as Bearer).
statement ok
CREATE SECRET oauth (TYPE notion, OAUTH_ACCESS_TOKEN 'ntn_test_token', BASE_URL '{NOTION_FIXTURE_URL}', REQUESTS_PER_SECOND '50');

query I
SELECT count(*) FROM notion.main.users WHERE id = '1a2b3c4d-0000-4000-8000-00000000e001';
----
1

statement ok
DROP SECRET oauth;

statement ok
CREATE SECRET notion (TYPE notion, TOKEN 'ntn_test_token', BASE_URL '{NOTION_FIXTURE_URL}', REQUESTS_PER_SECOND '50');

# The token is redacted in duckdb_secrets().
query I
SELECT secret_string LIKE '%ntn_test_token%' FROM duckdb_secrets() WHERE name = 'notion';
----
false

# Every request carried the bearer token and the pinned Notion-Version.
query II
SELECT DISTINCT auth, version FROM read_json('{NOTION_FIXTURE_URL}/__requests?path=/v1/users/1a2b3c4d-0000-4000-8000-00000000e001');
----
ok	2026-03-11

# ======================================================================== discovery

statement ok
SELECT * FROM read_json('{NOTION_FIXTURE_URL}/__reset');

# search: everything shared, paged 3 at a time; the first call is rate-limited once (429 Retry-After: 1).
query TTTT
SELECT object, title, parent_type, database_id FROM notion.main.search() ORDER BY object, title;
----
data_source	Bugs	database_id	1a2b3c4d-0000-4000-8000-00000000d003
data_source	Projects	database_id	1a2b3c4d-0000-4000-8000-00000000d002
data_source	Requests	database_id	1a2b3c4d-0000-4000-8000-00000000d003
data_source	Tasks	database_id	1a2b3c4d-0000-4000-8000-00000000d001
page	Crash on empty query	data_source_id	1a2b3c4d-0000-4000-8000-00000000d001
page	Docs	data_source_id	1a2b3c4d-0000-4000-8000-00000000d002
page	Engineering Wiki	page_id	NULL
page	Index documents	data_source_id	1a2b3c4d-0000-4000-8000-00000000d001
page	Meeting Notes	workspace	NULL
page	Product Roadmap	workspace	NULL
page	Release 1.0	data_source_id	1a2b3c4d-0000-4000-8000-00000000d001
page	Search	data_source_id	1a2b3c4d-0000-4000-8000-00000000d002
page	Search UI	data_source_id	1a2b3c4d-0000-4000-8000-00000000d001
page	Search revamp	data_source_id	1a2b3c4d-0000-4000-8000-00000000d001
page	Write docs	data_source_id	1a2b3c4d-0000-4000-8000-00000000d001

# 15 results / 3 per page = 5 pages, plus the one 429 that was retried after its Retry-After.
query III
SELECT count(*), count(*) FILTER (WHERE body::JSON->>'start_cursor' IS NOT NULL), (max(t) FILTER (WHERE seq = 2) - min(t)) >= 0.9
FROM read_json('{NOTION_FIXTURE_URL}/__requests?path=/v1/search');
----
6	4	true

# WHERE object = 'page' and the query argument push into the search body.
query T
SELECT title FROM notion.main.search(query := 'search') WHERE object = 'page' ORDER BY title;
----
Search
Search UI
Search revamp

query TT
SELECT body::JSON->>'query', body::JSON->'filter'->>'value' FROM read_json('{NOTION_FIXTURE_URL}/__requests?path=/v1/search') ORDER BY seq DESC LIMIT 1;
----
search	page

query TII
SELECT title, property_count, len(property_names) FROM notion.main.data_sources ORDER BY title;
----
Bugs	1	1
Projects	2	2
Requests	1	1
Tasks	21	21

# WHERE id = … reads the data source directly; WHERE database_id = … lists the database's sources.
query T
SELECT title FROM notion.main.data_sources WHERE id = '1a2b3c4d-0000-4000-8000-00000000d502';
----
Projects

query T
SELECT title FROM notion.main.data_sources WHERE database_id = '1a2b3c4d-0000-4000-8000-00000000d003' ORDER BY title;
----
Bugs
Requests

query TTT
SELECT title, data_source_ids, is_inline FROM notion.main.databases ORDER BY title;
----
Feedback	[1a2b3c4d-0000-4000-8000-00000000d503, 1a2b3c4d-0000-4000-8000-00000000d504]	false
Projects	[1a2b3c4d-0000-4000-8000-00000000d502]	false
Tasks	[1a2b3c4d-0000-4000-8000-00000000d501]	true

query TT
SELECT title, data_sources[1].name FROM notion.main.databases WHERE id = '1a2b3c4d-0000-4000-8000-00000000d001';
----
Tasks	Tasks

# users: paged 2 at a time; the first call is rate-limited once. Emails only when Notion returns them.
query TTT
SELECT name, type, email FROM notion.main.users ORDER BY name;
----
Ada Lovelace	person	ada@example.com
Grace Hopper	person	grace@example.com
Linus Torvalds	person	NULL
VGI Notion	bot	NULL

query II
SELECT count(*), (max(t) FILTER (WHERE seq = (SELECT min(seq) + 1 FROM read_json('{NOTION_FIXTURE_URL}/__requests?path=/v1/users'))) - min(t)) >= 0.9
FROM read_json('{NOTION_FIXTURE_URL}/__requests?path=/v1/users');
----
3	true

# =================================================================== schema mapping

query TTTTT
SELECT property, type, column_name, sql_type, json_column FROM notion.main.data_source_schema('1a2b3c4d-0000-4000-8000-00000000d501') ORDER BY position;
----
Name	title	Name	VARCHAR	Name__json
Status	status	Status	VARCHAR	NULL
Priority	select	Priority	VARCHAR	NULL
Tags	multi_select	Tags	VARCHAR[]	NULL
Assignee	people	Assignee	VARCHAR[]	NULL
Due	date	Due	STRUCT("start" TIMESTAMP WITH TIME ZONE, "end" TIMESTAMP WITH TIME ZONE, time_zone VARCHAR, has_time BOOLEAN)	NULL
Estimate	number	Estimate	DOUBLE	NULL
Blocked	checkbox	Blocked	BOOLEAN	NULL
Project	relation	Project	VARCHAR[]	NULL
Notes	rich_text	Notes	VARCHAR	Notes__json
URL	url	URL_2	VARCHAR	NULL
Owner email	email	Owner email	VARCHAR	NULL
Attachments	files	Attachments	STRUCT("name" VARCHAR, "type" VARCHAR, url VARCHAR, expiry_time TIMESTAMP WITH TIME ZONE)[]	NULL
Task ID	unique_id	Task ID	BIGINT	NULL
Created	created_time	Created	TIMESTAMP WITH TIME ZONE	NULL
Edited by	last_edited_by	Edited by	VARCHAR	NULL
Score	formula	Score	DOUBLE	NULL
Label	formula	Label	VARCHAR	NULL
Project count	rollup	Project count	DOUBLE	NULL
Project names	rollup	Project names	VARCHAR[]	NULL
Run	button	NULL	NULL	NULL

query TTT
SELECT property, unnest(options).name AS option, unnest(options)."group" FROM notion.main.data_source_schema('1a2b3c4d-0000-4000-8000-00000000d501') WHERE type = 'status' ORDER BY option;
----
Status	Done	Complete
Status	In progress	In progress
Status	Not started	To-do

query TTTT
SELECT relation_data_source_id, formula_expression, rollup_function, unique_id_prefix FROM notion.main.data_source_schema('1a2b3c4d-0000-4000-8000-00000000d501') WHERE property IN ('Project', 'Score', 'Project count', 'Task ID') ORDER BY position;
----
1a2b3c4d-0000-4000-8000-00000000d502	NULL	NULL	NULL
NULL	NULL	NULL	TASK
NULL	prop("Estimate") * 2	NULL	NULL
NULL	NULL	count	NULL

# A database id resolves to its only data source; rich_text_json := false drops the __json siblings.
query I
SELECT count(*) FROM notion.main.data_source_schema('https://www.notion.so/acme/Tasks-1a2b3c4d00004000800000000000d001?v=0f0f', rich_text_json := false) WHERE json_column IS NOT NULL;
----
0

# The bound columns match the schema (DESCRIBE binds query_data_source).
query TT
SELECT column_name, column_type FROM (DESCRIBE SELECT * FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501')) WHERE column_name IN ('id', 'Name__json', 'Due', 'URL_2', 'url', 'Score', 'Label', 'in_trash') ORDER BY column_name;
----
Due	STRUCT("start" TIMESTAMP WITH TIME ZONE, "end" TIMESTAMP WITH TIME ZONE, time_zone VARCHAR, has_time BOOLEAN)
Label	VARCHAR
Name__json	JSON
Score	DOUBLE
URL_2	VARCHAR
id	VARCHAR
in_trash	BOOLEAN
url	VARCHAR

# ======================================================================= row values

query TTTTTRTI
SELECT "Name", "Status", "Priority", "Tags", "Assignee", "Estimate", "Blocked", "Task ID" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') ORDER BY "Task ID";
----
Search revamp	In progress	High	[search, backend]	[1a2b3c4d-0000-4000-8000-00000000e001]	5.0	false	1
Index documents	Done	Medium	[search, backend]	[1a2b3c4d-0000-4000-8000-00000000e001, 1a2b3c4d-0000-4000-8000-00000000e002]	3.0	false	2
Crash on empty query	Not started	High	[backend]	[1a2b3c4d-0000-4000-8000-00000000e002]	2.0	true	3
Search UI	In progress	Low	[frontend, search]	[]	8.0	false	4
Write docs	Not started	NULL	[docs]	[1a2b3c4d-0000-4000-8000-00000000e003]	NULL	false	5
Release 1.0	Done	High	[]	[1a2b3c4d-0000-4000-8000-00000000e001]	1.0	false	6

# Six rows, two per page: three query pages. The cursor travels in scan state.
query I
SELECT count(*) FROM read_json('{NOTION_FIXTURE_URL}/__requests?path=/v1/data_sources/1a2b3c4d-0000-4000-8000-00000000d501/query') WHERE body::JSON->>'page_size' = '100';
----
3

# Projection pushdown: only the selected properties are requested (filter_properties).
query T
SELECT query FROM read_json('{NOTION_FIXTURE_URL}/__requests?path=/v1/data_sources/1a2b3c4d-0000-4000-8000-00000000d501/query') ORDER BY seq DESC LIMIT 1;
----
{"filter_properties": ["title", "st:a", "pri1", "tag1", "ppl1", "est1", "chk1", "uid1"]}

# Dates: all-day dates are 00:00 UTC with has_time false; ranges carry end and time zone.
query TTTTT
SELECT "Name", "Due".start = TIMESTAMPTZ '2026-10-15 10:00:00+00', "Due"."end" = TIMESTAMPTZ '2026-10-20 18:00:00+00', "Due".time_zone, "Due".has_time
FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') WHERE "Task ID" = 2;
----
Index documents	true	true	Europe/London	true

query TTT
SELECT "Name", "Due".start = TIMESTAMPTZ '2026-11-20 00:00:00+00', "Due".has_time FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') WHERE "Task ID" = 1;
----
Search revamp	true	false

# Rich text: plain text plus the raw JSON sibling; url / email; files; formula and rollup by result type.
query TTTTT
SELECT "Notes", "Notes__json"->1->>'plain_text', "URL_2", "Owner email", "Attachments"[1].name FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') WHERE "Task ID" = 1;
----
Ship search by Q4	search	https://example.com/spec/1	ada@example.com	spec.pdf

query TRTRT
SELECT "Name", "Score", "Label", "Project count", "Project names" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') ORDER BY "Task ID";
----
Search revamp	10.0	Search revamp (In progress)	1.0	[Search]
Index documents	6.0	Index documents (Done)	1.0	[Search]
Crash on empty query	4.0	Crash on empty query (Not started)	0.0	[]
Search UI	16.0	Search UI (In progress)	2.0	[Search, Docs]
Write docs	NULL	Write docs (Not started)	1.0	[Docs]
Release 1.0	2.0	Release 1.0 (Done)	2.0	[Search, Docs]

# A relation truncated in the page object (has_more) is completed from the property item endpoint (paged 1 at a time).
query TT
SELECT "Name", "Project" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') WHERE "Task ID" = 4;
----
Search UI	[1a2b3c4d-0000-4000-8000-00000000c101, 1a2b3c4d-0000-4000-8000-00000000c102]

query I
SELECT count(*) >= 2 FROM read_json('{NOTION_FIXTURE_URL}/__requests?path=/v1/pages/1a2b3c4d-0000-4000-8000-00000000c004/properties/rel1');
----
true

query TTTT
SELECT "Created" = TIMESTAMPTZ '2026-10-01 09:00:00+00', created_time = TIMESTAMPTZ '2026-10-01 09:00:00+00', "Edited by", in_trash
FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') WHERE "Task ID" = 1;
