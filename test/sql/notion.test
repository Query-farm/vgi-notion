# Joining a relation to another data source and people to users.
query TT
SELECT t."Name", p."Name" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') t
JOIN notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d502') p ON list_contains(t."Project", p.id)
WHERE t."Status" = 'Done' ORDER BY 1, 2;
----
Index documents	Search
Release 1.0	Docs
Release 1.0	Search

query T
SELECT t."Name" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') t, notion.main.users u
WHERE list_contains(t."Assignee", u.id) AND u.name = 'Ada Lovelace' ORDER BY 1;
----
Index documents
Release 1.0
Search revamp

