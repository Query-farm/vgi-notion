true	true	1a2b3c4d-0000-4000-8000-00000000e001	false

# ======================================================================= pushdown

# The last query request's filter object, for the checks below.
statement ok
CREATE MACRO last_filter() AS TABLE
SELECT body::JSON->'filter' AS f FROM read_json('{NOTION_FIXTURE_URL}/__requests?path=/v1/data_sources/1a2b3c4d-0000-4000-8000-00000000d501/query')
WHERE body::JSON->>'page_size' = '100' ORDER BY seq DESC LIMIT 1;

# status equality + a number range → an `and` of two property conditions (by property id).
query T
SELECT "Name" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') WHERE "Status" = 'In progress' AND "Estimate" >= 5 ORDER BY 1;
----
Search UI
Search revamp

query T
SELECT f FROM last_filter();
----
{"and":[{"property":"st%3Aa","status":{"equals":"In progress"}},{"property":"est1","number":{"greater_than_or_equal_to":5}}]}

# IN → or; list_contains on multi_select; LIKE '%…%' → contains (a prefix LIKE reaches the worker as a range and stays in the SDK); created_time → a widened timestamp filter.
query T
SELECT "Name" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501')
WHERE "Status" IN ('Done', 'Not started') AND list_contains("Tags", 'backend') AND "Name" LIKE '%empty%' AND created_time >= TIMESTAMPTZ '2026-10-03 00:00:00+00';
----
Crash on empty query

query T
SELECT f FROM last_filter();
----
{"and":[{"or":[{"property":"st%3Aa","status":{"equals":"Done"}},{"property":"st%3Aa","status":{"equals":"Not started"}}]},{"property":"tag1","multi_select":{"contains":"backend"}},{"property":"title","title":{"contains":"empty"}},{"timestamp":"created_time","created_time":{"on_or_after":"2026-10-01T22:00:00.000Z"}}]}

# The widened created_time bound let Index documents (Oct 2) through the server; the SDK re-applies the exact predicate.
query T
SELECT "Name" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') WHERE created_time > TIMESTAMPTZ '2026-10-04 09:00:00+00' ORDER BY 1;
----
Release 1.0
Write docs

# people contains, NOT checkbox, unique_id, select IS NULL → is_empty, rich text IS NOT NULL → is_not_empty.
query T
SELECT "Name" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') WHERE list_contains("Assignee", '1a2b3c4d-0000-4000-8000-00000000e002') AND NOT "Blocked";
----
Index documents

query T
SELECT f FROM last_filter();
----
{"and":[{"property":"ppl1","people":{"contains":"1a2b3c4d-0000-4000-8000-00000000e002"}},{"property":"chk1","checkbox":{"equals":false}}]}

query T
SELECT "Name" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') WHERE "Priority" IS NULL AND "Task ID" > 1;
----
Write docs

query T
SELECT f FROM last_filter();
----
{"and":[{"property":"pri1","select":{"is_empty":true}},{"property":"uid1","unique_id":{"greater_than":1}}]}

query T
SELECT "Name" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') WHERE "Notes" IS NOT NULL ORDER BY 1;
----
Crash on empty query
Search revamp

query T
SELECT f FROM last_filter();
----
{"property":"txt1","rich_text":{"is_not_empty":true}}

# A date's start: only the (widened) lower bound is sent; the upper bound is re-checked by the SDK.
query T
SELECT "Name" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501')
WHERE "Due".start >= TIMESTAMPTZ '2026-11-04 00:00:00+00' AND "Due".start < TIMESTAMPTZ '2026-12-01 00:00:00+00' ORDER BY 1;
----
Search revamp
Write docs

query T
SELECT f FROM last_filter();
----
{"property":"due1","date":{"on_or_after":"2026-11-02T22:00:00.000Z"}}

# Formula number / string conditions; a relation contains.
query T
SELECT "Name" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') WHERE "Score" > 5 AND list_contains("Project", '1a2b3c4d-0000-4000-8000-00000000c102');
----
Search UI

query T
SELECT f FROM last_filter();
----
{"and":[{"property":"fml1","formula":{"number":{"greater_than":5}}},{"property":"rel1","relation":{"contains":"1a2b3c4d-0000-4000-8000-00000000c102"}}]}

query T
SELECT "Name" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') WHERE "Label" = 'Write docs (Not started)';
----
Write docs

query T
SELECT f FROM last_filter();
----
{"property":"fml2","formula":{"string":{"equals":"Write docs (Not started)"}}}

# Untranslatable predicates are not sent (and the SDK applies them): text <> and a function call.
query T
SELECT "Name" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501') WHERE "Status" <> 'Done' AND lower("Name") = 'search ui';
----
Search UI

query T
SELECT f FROM last_filter();
----
NULL

# notion_filter (raw Notion JSON) is ANDed with the pushed WHERE; notion_sorts orders the rows.
query T
SELECT "Name" FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501',
  notion_filter := '{"property":"Tags","multi_select":{"contains":"search"}}',
  notion_sorts := '[{"property":"Estimate","direction":"descending"}]') WHERE "Status" = 'In progress';
----
Search UI
Search revamp

query TT
SELECT body::JSON->'filter', body::JSON->'sorts' FROM read_json('{NOTION_FIXTURE_URL}/__requests?path=/v1/data_sources/1a2b3c4d-0000-4000-8000-00000000d501/query') WHERE body::JSON->>'page_size' = '100' ORDER BY seq DESC LIMIT 1;
----
{"and":[{"property":"Tags","multi_select":{"contains":"search"}},{"property":"st%3Aa","status":{"equals":"In progress"}}]}	[{"property":"Estimate","direction":"descending"}]

statement error
SELECT count(*) FROM notion.main.query_data_source('1a2b3c4d-0000-4000-8000-00000000d501', notion_filter := '{not json');
