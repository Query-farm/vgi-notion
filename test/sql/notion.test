# blocks: depth-first, nested children, sub-pages and child databases not walked by default.
query ITTTT
SELECT depth, path, type, replace(text, chr(9), ' | '), checked FROM notion.main.blocks('1a2b3c4d-0000-4000-8000-00000000a001') ORDER BY path;
----
1	00000	heading_1	Goals	NULL
1	00001	paragraph	Ship search by Q4.	NULL
1	00002	bulleted_list_item	Faster indexing	NULL
2	00002.00000	bulleted_list_item	Sharding	NULL
2	00002.00001	bulleted_list_item	Caching	NULL
1	00003	bulleted_list_item	Better ranking	NULL
1	00004	numbered_list_item	Design	NULL
