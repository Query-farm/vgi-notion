# ================================================================== rate limiting

# A 2 request/second token bucket (burst 2): seven user lookups take at least 2.5 s.
statement ok
CREATE OR REPLACE SECRET notion (TYPE notion, TOKEN 'ntn_test_token', BASE_URL '{NOTION_FIXTURE_URL}', REQUESTS_PER_SECOND '2');

statement ok
SELECT * FROM read_json('{NOTION_FIXTURE_URL}/__reset');

query I
